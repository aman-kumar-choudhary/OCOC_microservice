DATABASE_URL=postgres://notification_user:notification_password@localhost:5432/notification_system?sslmode=disable
SERVER_ADDR=localhost:8082

# Internal Security
NOTIFICATION_API_KEY=your-secure-internal-api-key
INTERNAL_SERVICE_SECRET=your-internal-service-secret

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_APP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com

# Retries & Worker Settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
RETRY_DELAY=5
DEDUP_WINDOW_SECONDS=300
NOTIFICATION_RATE_LIMIT=100
MAX_CONCURRENCY=10
NOTIFICATION_ASYNC=true
QUEUE_BUFFER_SIZE=100

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=notification.exchange
EMAIL_QUEUE=email.queue
WHATSAPP_QUEUE=whatsapp.queue
EMAIL_DLQ=email.dlq
WHATSAPP_DLQ=whatsapp.dlq
EMAIL_WORKER_CONCURRENCY=5
WHATSAPP_WORKER_CONCURRENCY=5

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-cloud-api-token
TO=919876543210
PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_MESSAGE_TYPE=template
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_INCLUDE_MESSAGE=false
