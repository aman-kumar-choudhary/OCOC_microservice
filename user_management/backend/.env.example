# Server
SERVER_ADDR=0.0.0.0:8080
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://ococ:ococ_secret@localhost:5432/ococ_users?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_SECONDS=300

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
OTP_TTL_SECONDS=600

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=ococ
KEYCLOAK_CLIENT_ID=user-management
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# JWT
JWT_ISSUER=http://localhost:8180/realms/ococ
JWT_AUDIENCE=user-management

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ococ.campus.edu

# RFID Reader
RFID_READER_URL=ws://localhost:9001/rfid
RFID_READER_SIMULATE=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
PHOTO_UPLOAD_DIR=./uploads/photos
MAX_UPLOAD_SIZE_MB=5
MAX_CSV_SIZE_MB=10
MAX_CSV_ROWS=5000
